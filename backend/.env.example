# =============================================================================
#  SMC backend configuration  (template: copy to backend/.env)
# =============================================================================
#  Read at startup by app/config.py (and the modules named below). Real
#  environment variables override this file - Docker sets HOST/PORT/paths and
#  the RTMP ingest values itself (see docker-compose.yml and SMC/.env).
#
#  Lines starting with "#" are optional settings shown with their DEFAULT;
#  remove the "#" and change the value to use them.
#  Never commit this file: it holds secrets. Copy this file to backend/.env and fill in the secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Environment and server
# -----------------------------------------------------------------------------
# development | production | test. production refuses an unsafe config, logs
# to files, uses offline models and turns off /docs.
APP_ENV=development

# Backend address. SMC uses 8822 (MAINDV's backend uses 8821 on this machine).
HOST=127.0.0.1
PORT=8822

# Browser origins allowed to call the API (comma separated, never *). Must
# match the frontend's address (frontend runs on 5180).
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# ENABLE_API_DOCS=false
# Behind nginx: trust X-Forwarded-For for the client IP (login throttling).
# TRUST_PROXY_HEADERS=false


# -----------------------------------------------------------------------------
# 2. Security  (production: REQUIRED - never commit real values)
# -----------------------------------------------------------------------------
# Signs license QR codes. Empty = a random key per start (QR codes stop
# verifying after a restart). Generate 64 hex chars with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# One-time bootstrap of the first admin (only used when no admin exists).
# Prefer: python -m app.manage create-admin --email you@example.com
# If you use these, remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sessions and logins
# SESSION_TTL_HOURS=12
# PASSWORD_MIN_LENGTH=10
# LOGIN_RATE_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_USER=5
# MAX_UPLOAD_MB=5


# -----------------------------------------------------------------------------
# 3. Features
# -----------------------------------------------------------------------------
# AI features this deployment offers (comma separated). Anything not listed
# never runs and is hidden. Keep in sync with frontend VITE_ENABLED_FEATURES.
# Keys: footfall, face_recognition, staff_count, live_overlay, visitors,
#       desk_analytics, expression, appearance_handoff, alerts.  Empty = all.
ENABLED_FEATURES=footfall,face_recognition,staff_count,live_overlay,visitors


# -----------------------------------------------------------------------------
# 4. Cameras and video streams  (app/camera_stream.py, app/rtsp_reader.py)
# -----------------------------------------------------------------------------
# A camera this many seconds behind live reconnects to catch up. The default
# (3) made cameras reconnect every few seconds on this busy machine.
RTSP_MAX_LAG_SECONDS=12

# FFmpeg decoder threads per camera (0 = FFmpeg decides, one per CPU core).
# RTSP_DECODE_THREADS=2
# LIVE_STREAM_FPS=8
# RTSP_CONNECT_TIMEOUT=20        # seconds to open a stream (NVRs over WAN are slow)
# RTSP_READ_TIMEOUT=10           # seconds one read may block
# RTSP_RECONNECT_DELAY=2         # first retry; doubles up to the max
# RTSP_RECONNECT_MAX_DELAY=60    # keeps NVRs from locking the account
# RTSP_MAX_RETRIES=10            # failures before a camera is reported FAILED
# CAMERA_FRAME_TIMEOUT=20        # no frame for this long = stalled, restart
# CAMERA_WATCHDOG_INTERVAL=2


# -----------------------------------------------------------------------------
# 5. Face recognition and live person boxes  (app/face_pipeline.py)
# -----------------------------------------------------------------------------
# Tuned so face recognition runs on ALL cameras on this 8-core laptop:
# analyse each camera 2x/s (default 3) and run the heavy backup person
# detector every 24 frames (default 12).
FACE_PIPELINE_FPS=2
PERSON_RESCUE_INTERVAL_FRAMES=24

# Recognition (cosine similarity against enrolled photos; higher = stricter)
# FACE_LIVE_MATCH_THRESHOLD=0.35     # name someone live from enrolled photos
# FACE_MATCH_THRESHOLD=0.45          # review / auto-assign tiers
# FACE_MATCH_MARGIN=0.05             # lead needed over the 2nd-best person
# FACE_CLASSIFIER_MIN_PROBA=0.6      # trained classifier confidence
# RECOGNITION_STABILITY_FRAMES=2     # agreeing reads before a name is shown
# INSTANT_COMMIT_SIMILARITY=0.5      # ...unless one read is this strong
# INSTANT_COMMIT_MARGIN=0.15         # ...and this far ahead of the next person
# ATTENDANCE_MIN_CONFIDENCE=0.8

# Detection
# FACE_DETECT_IMGSZ=960              # face detector input (smaller misses far faces)
# FACE_EMBED_DET_SIZE=256            # re-detection inside a face crop
# FACE_EMBED_RETRY=1                 # retry a missed face once with a border
# PERSON_DETECT_IMGSZ=960            # person detector input
# PERSON_DETECT_CONF=0.3

# Keeping boxes and names on screen
# PERSON_TRACK_MAX_SECONDS=6         # box kept this long after the last detection
# PERSON_TRACK_MAX_HOLD_SECONDS=15   # ...longer when the machine is slow, up to this
# IDENTITY_GRACE_SECONDS=600         # a name stays with its person track

# Face-image collection window in days (default: indefinitely).
# FACE_COLLECTION_DAYS=36500


# -----------------------------------------------------------------------------
# 6. Diagnostics
# -----------------------------------------------------------------------------
# One rate-limited log line per recognition rejection reason (no images or
# names). Set to 0 once recognition is confirmed working.
FACE_DIAG=1
# FACE_DIAG_INTERVAL_SECONDS=10
# How often Python hands its lock to the API thread (seconds); keeps the API
# responsive while the AI threads are busy.
# PY_GIL_SWITCH_INTERVAL=0.0005


# -----------------------------------------------------------------------------
# 7. Unique footfall  (app/reid/config.py)
# -----------------------------------------------------------------------------
# REID_SIMILARITY_THRESHOLD=0.75
# REID_MOT_INTERVAL_SECONDS=0.5
# REID_MIN_ASPECT_RATIO=1.5
# REID_LEARN_BELOW_SIMILARITY=0.88
# REID_MAX_EMBEDDINGS_PER_PERSON=30


# -----------------------------------------------------------------------------
# 7b. Visitor seating-area alerts  (app/visitors.py)
# -----------------------------------------------------------------------------
# Unknown person seated in the marked area: alert after this many seconds of
# unbroken presence (also the wait after each repeat becomes due).
# VISITOR_DETECTION_GAP_SECONDS=10
# Alert again while they stay seated, every N minutes (0 = once per visit).
# VISITOR_REPEAT_ALERT_MINUTES=30
# Seconds out of the area before a visit ends (coming back = new visit).
# VISITOR_ABSENCE_GRACE_SECONDS=60
# A detection loss longer than this restarts the detection-gap wait only.
# VISITOR_PRESENCE_BREAK_SECONDS=3
# 1 = people the face pipeline recognises as enrolled employees never alert.
# VISITOR_EXCLUDE_EMPLOYEES=1
# Which recognitions count: face, appearance (body matched to someone
# face-recognised today), or both.
# VISITOR_EMPLOYEE_SOURCES=face,appearance


# -----------------------------------------------------------------------------
# 8. External Identity (face-enrollment) service
# -----------------------------------------------------------------------------
# Reached only by the backend; must be https:// in production. Empty = the
# People roster sync and gallery sync report "not configured".
IDENTITY_SERVICE_BASE=
# EXTERNAL_HTTP_TIMEOUT=15


# -----------------------------------------------------------------------------
# 9. Paths and models
# -----------------------------------------------------------------------------
# DATA_DIR=./data                    # database, captures, snapshots, classifier
# DB_PATH=./data/app.db
# MODEL_DIR=./models                 # YOLO / Re-ID / emotion weights
# LOG_DIR=./logs
# MODEL_OFFLINE_MODE=false           # true = never download weights at runtime
# INSIGHTFACE_ROOT=~/.insightface    # InsightFace looks for <root>/models/buffalo_l


# -----------------------------------------------------------------------------
# 10. Maintenance: retention, recovery, logging
# -----------------------------------------------------------------------------
# RETENTION_ENABLED=true
# RETENTION_DELETE_ORPHANS=false     # true = also delete image files no DB row references
# RETENTION_INTERVAL_SECONDS=3600
# FACE_PENDING_RETENTION_DAYS=30
# FACE_CAPTURE_RETENTION_DAYS=60     # unlabeled/rejected only; labeled = kept
# SNAPSHOT_RETENTION_DAYS=30
# ALERT_SNAPSHOT_RETENTION_DAYS=90
# MODEL_BACKUP_RETENTION_COUNT=5
# MAX_TRAINING_CAPTURES=15000

# FEATURE_RETRY_BASE_SECONDS=5
# FEATURE_RETRY_MAX_SECONDS=300
# FEATURE_REBUILD_AFTER_FAILURES=3

# LOG_LEVEL=INFO
# LOG_TO_FILE=false
# LOG_FILE_MAX_MB=20
# LOG_BACKUP_COUNT=10
