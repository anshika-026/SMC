# Copy to frontend/.env for local development (npm run dev).
# Backend API base URL. Local dev backend: http://127.0.0.1:8822/api
# Production builds use .env.production (relative /api) instead.
VITE_API_BASE_URL=http://127.0.0.1:8822/api
# Path the app is served under: / for its own host (default), /smc/ under tatv.dewin.in.
VITE_BASE_PATH=/
# true = show sample data on pages that have no backend yet (demo only).
VITE_DEMO_MODE=false
# AI features to show (must match backend ENABLED_FEATURES). SMC: footfall only.
VITE_ENABLED_FEATURES=footfall
