# Production build: the SPA and the API share one origin behind nginx, which
# proxies /api and /ws to the backend (see DEPLOYMENT.md). Relative, so the
# same build works for any hostname and follows http/https automatically.
VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
# AI features to show (must match backend ENABLED_FEATURES). SMC: footfall only.
VITE_ENABLED_FEATURES=footfall
