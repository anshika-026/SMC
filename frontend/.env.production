# Production build: the SPA and the API share one origin behind nginx, which
# proxies /smc/api and /smc/ws to the backend (deploy/gpu/nginx-smc-location.conf).
# Relative, so the build follows http/https automatically.
VITE_API_BASE_URL=/smc/api
# Served under https://tatv.dewin.in/smc/ (the Master Portal's site), so the
# portal's existing address and certificate are reused. For its own host, set
# VITE_BASE_PATH=/ and VITE_API_BASE_URL=/api.
VITE_BASE_PATH=/smc/
VITE_DEMO_MODE=false
# Same modules as the running SMC (backend ENABLED_FEATURES must match).
# The Master Portal licence then decides which of these each client sees.
VITE_ENABLED_FEATURES=footfall,face_recognition,staff_count,live_overlay,visitors,intrusion
