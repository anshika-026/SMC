# Copy to backend/.env and fill in. backend/.env is git-ignored - never
# commit real camera credentials.

# --- SMC cameras (unique footfall runs ONLY on these two) ------------------
# Put the username/password in the separate fields, not in the URL: they are
# percent-encoded for you, so a password containing "@" or ":" works.
CAMERA_1_NAME=Camera 1
CAMERA_1_URL=rtsp://144.79.198.149:8554/video/live?channel=1&subtype=0
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=

CAMERA_2_NAME=Camera 2
CAMERA_2_URL=rtsp://144.79.198.149:8555/video/live?channel=1&subtype=0
CAMERA_2_USERNAME=admin
CAMERA_2_PASSWORD=

RTSP_TRANSPORT=tcp

# --- API -------------------------------------------------------------------
# Optional. When set, the dashboard must send the same value (VITE_API_TOKEN).
API_TOKEN=
CORS_ORIGINS=http://localhost:5180

# --- Storage / models ------------------------------------------------------
# DATA_DIR=./data
# MODEL_DIR=./models
# true = refuse to start Re-ID without models/osnet_x0_25_msmt17.pth
MODEL_OFFLINE_MODE=false
