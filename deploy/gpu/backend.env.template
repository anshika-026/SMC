# ~/smc/backend.env on the shared DeWIN GPU server (chmod 600; never commit the real one).
# Placeholders are <...>. Full list of settings: backend/.env.example and backend/app/config.py.

APP_ENV=production
HOST=127.0.0.1
# Deco Vision uses 18811 (prod) and 18812 (stage); SMC takes 18821.
PORT=18821
CORS_ORIGINS=https://smc.dewin.in
TRUST_PROXY_HEADERS=true
MODEL_OFFLINE_MODE=true
TZ=Asia/Kolkata
# Licence QR codes and other signed values; a new random value is fine:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<random>

# Everything stateful lives outside the release directories.
DATA_DIR=/home/kanishka/smc/data
LOG_DIR=/home/kanishka/smc/logs
MODEL_DIR=/home/kanishka/smc/models
INSIGHTFACE_ROOT=/home/kanishka/smc/insightface
HF_HOME=/home/kanishka/smc/hf

# The same modules as the SMC running today (and frontend/.env.production);
# the Master Portal licence then decides which of them the client sees.
ENABLED_FEATURES=footfall,face_recognition,staff_count,live_overlay,visitors,intrusion

# Must be the SAME value as on the laptop SMC (backend/.env): it decrypts the
# credentials already stored in SMC's database (SMC Connect / WhatsApp).
SMC_CREDENTIALS_KEY=<copy from the laptop's backend/.env>

# --- Deco Vision Master Portal (master_link.py) ---------------------------------
INTEGRATION_MODE=master
MASTER_PORTAL_URL=https://tatv.dewin.in
# Where SMC sends people to sign in again: the client URL the portal generated.
MASTER_PORTAL_LOGIN_URL=https://tatv.dewin.in/client/smc/login
# From the SMC licence in Client License Management (production portal):
MASTER_LICENSE_ID=<licence id>
MASTER_APP_API_KEY=<dvk_... generated once in the licence's Application dialog>
# The portal's PUBLIC signing key (python -m app.manage show-sso-public-key on the portal):
MASTER_PORTAL_PUBLIC_KEY=<base64 public key>

# --- RTMP ingest (deploy/gpu/smc-mediamtx.service) -------------------------------
INGEST_RTSP_BASE=rtsp://127.0.0.1:18554
INGEST_API_URL=http://127.0.0.1:19997
INGEST_READ_USER=smc-reader
INGEST_READ_PASSWORD=<same as the laptop's SMC/.env, or a new random value>
INGEST_HOOK_SECRET=<same as the laptop's SMC/.env; also in ~/smc/mediamtx.env>
# What push cameras are told to publish to (the office relay forwards here).
RTMP_PUBLIC_HOST=smc.dewin.in
RTMP_PUBLIC_PORT=1935
RTMP_PUBLIC_SCHEME=rtmp

# --- GPU -------------------------------------------------------------------------
# The GPUs are shared. Pin SMC to the card with the most free memory at the
# capacity check (nvidia-smi), e.g. CUDA_VISIBLE_DEVICES=1.
CUDA_VISIBLE_DEVICES=<0 or 1>
